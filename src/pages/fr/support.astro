---
import LayoutDefault from '@layouts/LayoutDefault.astro';
import Btn from '@components/ui/Btn.astro';
import ContentVertical from '@components/position/ContentVertical.astro';
import Card from '@components/ui/Card.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { BOOKING_URL } from '../../consts';

import imageMael from '../../images/team/mael.webp';
import imageOlivia from '../../images/team/olivia.webp';
---

<LayoutDefault>
  <ContentVertical>
    <h1>Support / Nous contacter</h1>
    <p>
      La meilleure façon de nous joindre est par email à
      <a href="mailto:contact@ansearch.ai"> contact@ansearch.ai </a>.
      <br /> Nous sommes une petite équipe, nous répondrons au plus vite.
      <br />
      <br />
      Si vous préférez nous parler en personne, vous pouvez réserver un appel :
    </p>
    <div class="cards">
      <Card class="support-card">
        <div class="card-content">
          <Image src={imageMael} alt="Mael" />
          <h2>Mael</h2>
          <h3>CEO</h3>
          <em>Peut vous aider avec :</em>
          <ul>
            <li>Produit & prise en main</li>
            <li>Feedback sur le produit & demandes de fonctionnalités</li>
            <li>L'IA</li>
            <li>Sécurité & technologie</li>
          </ul>
        </div>
        <div class="card-footer">
          <a
            rel="noopener noreferrer"
            target="_blank"
            href="https://cal.com/mael-abgrall/30min"
            class="cta-link"
          >
            <Btn variant="secondary">
              Réserver un appel
              <Icon name="fa7-solid:arrow-right" />
            </Btn>
          </a>
        </div>
      </Card>

      <Card class="support-card">
        <div class="card-content">
          <Image src={imageOlivia} alt="Olivia" />
          <h2>Olivia</h2>
          <h3>CSMO</h3>
          <em>Peut vous aider avec :</em>
          <ul>
            <li>Questions générales</li>
            <li>Business & partenariat</li>
            <li>Tout le reste</li>
          </ul>
        </div>
        <div class="card-footer">
          <a
            rel="noopener noreferrer"
            target="_blank"
            href={BOOKING_URL}
            class="cta-link"
          >
            <Btn>
              Réserver un appel
              <Icon name="fa7-solid:arrow-right" />
            </Btn>
          </a>
        </div>
      </Card>
    </div>
  </ContentVertical>

  <style>
    @reference "tailwindcss";

    a {
      @apply text-amber-600;
      &:hover {
        @apply text-amber-800;
      }
    }

    .cards {
      display: flex;
      @apply gap-8;
    }

    .support-card {
      display: flex;
      flex-direction: column;
      flex: 1 1 0;
      width: 0;
    }

    .card-content {
      display: flex;
      flex-direction: column;
      flex: 1;
      width: 30ch;
      @apply gap-2;
    }

    .card-footer {
      @apply mt-auto pt-4;
    }

    .cta-link {
      text-decoration: none;
      display: block;
    }

    em,
    ul,
    h2,
    h3 {
      max-width: 30ch;
    }

    em {
      @apply text-stone-500 text-sm;
    }

    ul {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      text-align: left;
      @apply gap-1 p-2 list-disc pl-8;
    }

    img {
      @apply rounded-full;
      width: 96px;
      height: 96px;
      object-fit: cover;
      flex-shrink: 0;
      align-self: center;
    }
  </style>
</LayoutDefault>
