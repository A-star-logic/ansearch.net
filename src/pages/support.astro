---
import LayoutDefault from '@layouts/LayoutDefault.astro';
import Btn from '@components/ui/Btn.astro';
import ContentVertical from '@components/position/ContentVertical.astro';
import Card from '@components/ui/Card.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { BOOKING_URL } from '../consts';

import imageMael from '../images/team/mael.webp';
import imageOlivia from '../images/team/olivia.webp';
---

<LayoutDefault>
  <ContentVertical>
    <h1>Support / Contact us</h1>
    <p>
      The best way to reach us is at <a href="mailto:contact@ansearch.ai">
        contact@ansearch.ai
      </a>.
      <br /> We are a small team, so bear with us, we'll reply as soon as we can.
      <br />
      <br />
      If you would rather speak to us, you can book a call :
    </p>
    <div class="cards">
      <Card class="support-card">
        <div class="card-content">
          <Image src={imageMael} alt="Mael" />
          <h2>Mael</h2>
          <h3>CEO</h3>
          <em>Can help and answer questions with:</em>
          <ul>
            <li>Product & onboarding</li>
            <li>Feedback on the platform & feature requests</li>
            <li>AI</li>
            <li>Tech & security</li>
          </ul>
        </div>
        <div class="card-footer">
          <a
            rel="noopener noreferrer"
            target="_blank"
            href="https://cal.com/mael-abgrall/30min"
            class="cta-link"
          >
            <Btn variant="secondary">
              Book a call with me
              <Icon name="fa7-solid:arrow-right" />
            </Btn>
          </a>
        </div>
      </Card>

      <Card class="support-card">
        <div class="card-content">
          <Image src={imageOlivia} alt="Olivia" />
          <h2>Olivia</h2>
          <h3>CSMO</h3>
          <em>Can help and answer questions with:</em>
          <ul>
            <li>General questions</li>
            <li>Business & partnership</li>
            <li>Everything else</li>
          </ul>
        </div>
        <div class="card-footer">
          <a
            rel="noopener noreferrer"
            target="_blank"
            href={BOOKING_URL}
            class="cta-link"
          >
            <Btn>
              Book a call with me
              <Icon name="fa7-solid:arrow-right" />
            </Btn>
          </a>
        </div>
      </Card>
    </div>
  </ContentVertical>

  <style>
    @reference "tailwindcss";

    a {
      @apply text-amber-600;
      &:hover {
        @apply text-amber-800;
      }
    }

    .cards {
      display: flex;
      @apply gap-8;
    }

    .support-card {
      display: flex;
      flex-direction: column;
      flex: 1 1 0;
      width: 0;
    }

    .card-content {
      display: flex;
      flex-direction: column;
      flex: 1;
      width: 30ch;
      @apply gap-2;
    }

    .card-footer {
      @apply mt-auto pt-4;
    }

    .cta-link {
      text-decoration: none;
      display: block;
    }

    em,
    ul,
    h2,
    h3 {
      max-width: 30ch;
    }

    em {
      @apply text-stone-500 text-sm;
    }

    ul {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      text-align: left;
      @apply gap-1 p-2 list-disc pl-8;
    }

    img {
      @apply rounded-full;
      width: 96px;
      height: 96px;
      object-fit: cover;
      flex-shrink: 0;
      align-self: center;
    }
  </style>
</LayoutDefault>
